<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<!-- Define layouts if needed -->
	<variable name="requestLayout" value="${longdate} ${uppercase:${level}} ${message} ${exception:format=tostring}" />

	<targets>

		<!-- Target for all logs -->
		<!--
		<target name="file" xsi:type="File"
				fileName="${basedir}/logs/log.txt"
				
				archiveFileName="${basedir}/archives/log.{#}.txt"
				archiveEvery="Day"
				archiveNumbering="Rolling"
				maxArchiveFiles="7"
				
				layout="${longdate} ${level:uppercase=true} ${message}" />
		-->

		<!-- Target for Custom Request logs -->
		<target name="requestFile" xsi:type="File"
				fileName="${basedir}/logs/request.log"
				
				archiveFileName="${basedir}/archives/log.{#}.txt"
				archiveEvery="Day"
				archiveNumbering="Rolling"
				maxArchiveFiles="7"
				
				layout="${requestLayout}" />

		<!-- Target for Custom General logs -->
		<target name="generalFile" xsi:type="File"
				fileName="${basedir}/logs/general.log"
				
				archiveFileName="${basedir}/archives/log.{#}.txt"
				archiveEvery="Day"
				archiveNumbering="Rolling"
				maxArchiveFiles="7"
				
				layout="${requestLayout}" />

	</targets>

	<rules>
		<!-- Rule for all logs -->
		<!--
		<logger name="*" minlevel="Info" writeTo="file" />
		-->

		<!-- Rule for Custom Request logs -->
		<logger name="requestLogger" minlevel="Info" writeTo="requestFile" />

		<!-- Rule for Custom General logs -->
		<logger name="generalLogger" minlevel="Info" writeTo="generalFile" />
	</rules>
</nlog>
